{
  "name": "@sitepulse/backend",
  "version": "1.0.0",
  "private": true,
  "description": "SitePulse audit engine and REST API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:browsers": "playwright install chromium"
  },
  "dependencies": {
    "axe-core": "^4.10.2",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "domhandler": "^5.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "jsdom": "^25.0.1",
    "mongodb": "^6.10.0",
    "pdfkit": "^0.15.2",
    "playwright": "^1.49.1",
    "robots-parser": "^3.0.1",
    "tldts": "^6.1.61",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
