# ============================================================
# SitePulse — environment configuration
# Copy to `.env` (backend) and adjust. Never commit real secrets.
# ============================================================

# ---- Backend server ----
PORT=8787
NODE_ENV=development

# Comma separated list of allowed browser origins (the Next.js app).
# Use "*" only in development.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# URL of the frontend used to build shareable links in reports (optional).
FRONTEND_URL=http://localhost:3000

# ---- MongoDB (optional) ----
# Leave empty to run with the built-in in-memory store (audits are kept
# until the process restarts). Set a real connection string to persist
# audit history.
MONGODB_URI=
MONGODB_DB=sitepulse

# ---- AI recommendation layer (optional) ----
# Any OpenAI-compatible Chat Completions API. Used ONLY to rewrite the
# executive summary / recommendations wording after deterministic analysis.
# It never changes factual measurements.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

# ---- Audits & crawler ----
# Per-IP rate limit for starting audits (requests per window).
AUDIT_RATE_LIMIT_MAX=6
AUDIT_RATE_LIMIT_WINDOW_MS=60000

# How many audits may run simultaneously in this process.
AUDIT_CONCURRENCY=2

# Request timeouts in milliseconds.
HTTP_TIMEOUT_MS=15000
BROWSER_NAVIGATION_TIMEOUT_MS=45000
TOTAL_SCAN_TIMEOUT_MS=240000

# Hard crawl limits (overridable per scan type).
CRAWL_MAX_PAGES_STANDARD=10
CRAWL_MAX_PAGES_DEEP=50
CRAWL_MAX_DEPTH_DEEP=3

# ---- Security (SSRF protection) ----
# Default false in production. Keep false unless you run SitePulse inside a
# sandbox/demo where the audit target is a private fixture site. When false,
# targets resolving to loopback/private/link-local/metadata addresses are
# rejected. Cloud-metadata endpoints are ALWAYS blocked.
SITEPULSE_ALLOW_PRIVATE_TARGETS=false

# Comma separated additional hostnames always rejected (e.g. internal tools).
SITEPULSE_BLOCKED_HOSTS=

# ---- Browser rendering ----
# Set to true after running `npm run setup:browsers` in backend.
# When a browser is not available the engine performs an honest static
# (HTTP + DOM) analysis and reports unavailable metrics as "Not available".
PLAYWRIGHT_ENABLED=true

# ---- Demo / sample target (development only) ----
# Serves a realistic sample website with known issues on DEMO_SITE_PORT so
# you can try a real end-to-end audit in an offline sandbox.
DEMO_SITE_ENABLED=true
DEMO_SITE_PORT=8790
DEMO_SITE_URL=http://127.0.0.1:8790

# URL used by the landing page "Run example audit" action.
# Leave empty to auto-detect the demo site when enabled.
EXAMPLE_AUDIT_URL=

# Directory for runtime data: file-backed audit store + screenshots.
# Defaults to .data/ at the repository root when unset.
SITEPULSE_DATA_DIR=
